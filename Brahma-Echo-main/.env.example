# ==============================================================================
# Brahma Echo - Environment Configuration Example
# ==============================================================================
# Duplicate this file as '.env' and fill in your actual keys.
# ==============================================================================

# Primary AI Provider (Google Gemini)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Fast Inference Provider (Groq)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Multi-Model Fallback Provider (OpenRouter)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Claude API Key (Optional)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local AI / Ollama Configuration (Optional)
LOCAL_AI_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2

# Discord Remote Bridge (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Telegram Remote Bridge (Optional). Set TELEGRAM_CHAT_ID after the first /start
# message, or leave it blank to pair the first chat that messages the bot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=

# Instagram AI Assistant (Optional)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Smart Home Integration (Optional)
ATOMBERG_API_KEY=
ATOMBERG_REFRESH_TOKEN=
PHILIPS_HUE_BRIDGE_IP=
PHILIPS_HUE_API_KEY=

# App Controls
BRAHMA_SKIP_UPDATE=0
